{
  "name": "levi-music-bot",
  "version": "0.1.0",
  "description": "A Discord music bot powered by Bun, yt-dlp, and discord.js",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "deploy": "bun run src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:deps": "bun run scripts/check-deps.ts",
    "postinstall": "bun run scripts/fix-opus-abi.ts",
    "test": "bun test tests/utils tests/music tests/commands",
    "test:watch": "bun test --watch tests/utils tests/music tests/commands",
    "test:integration": "RUN_INTEGRATION_TESTS=1 bun test tests/integration",
    "test:all": "bun run audit:deps && bun run typecheck && bun run lint && bun run format:check && bun test tests/utils tests/music tests/commands",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,toml}": [
      "prettier --write"
    ]
  },
  "trustedDependencies": [
    "@discordjs/opus"
  ],
  "dependencies": {
    "@discordjs/opus": "0.10.0",
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.26.4",
    "libsodium-wrappers": "0.8.4",
    "prism-media": "1.3.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "@types/libsodium-wrappers": "0.8.2",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.4"
  }
}
