# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Required: application (client) id from the same page
DISCORD_CLIENT_ID=your-app-id-here

# Optional: if set, slash commands are registered to this guild only (instant updates).
# Leave empty to register globally (can take up to 1 hour to propagate).
DISCORD_GUILD_ID=

# Optional: path to yt-dlp binary if not on PATH
YTDLP_PATH=yt-dlp

# Optional: path to ffmpeg if not on PATH (used internally by prism-media)
FFMPEG_PATH=ffmpeg
